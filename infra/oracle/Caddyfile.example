# Phase 12A template only. Replace API_FQDN and install a Cloudflare Origin Certificate in Phase 12B.
# The API container remains bound to 127.0.0.1:8000; Caddy is the sole Oracle host listener on 443.
API_FQDN {
    tls /etc/caddy/origin-cert.pem /etc/caddy/origin-key.pem
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
    reverse_proxy 127.0.0.1:8000
}
