# Copy this file to .env for local development when configuration is introduced.
# Copy to .env for local development. Keep credentials and environment-specific values out of version control.
# Production uses platform-managed secrets and public Cloudflare Pages build variables; this file contains no usable secret.
APP_ENV=development
LOG_LEVEL=INFO
# Required in production: public HTTPS origins and explicit host allow-list.
APP_URL=
API_URL=
TRUSTED_HOSTS=
APP_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_SECONDS=900
# Required in production: Supabase TLS PostgreSQL URI. Do not expose this value to the frontend.
DATABASE_URL=postgresql+asyncpg://wde:wde@localhost:5432/wde
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=20
# Required in production: protected Upstash rediss:// URI. Do not expose this value to the frontend.
REDIS_URL=redis://localhost:6379/0
REDIS_OPERATION_BUDGET_PER_MINUTE=3000
# Private artifact storage. Production requires STORAGE_PROVIDER=supabase and a pre-created private bucket.
ARTIFACT_ROOT=/tmp/web-data-extraction-engine-artifacts
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_SECONDS=300
SUPABASE_REQUEST_TIMEOUT_SECONDS=15
ARTIFACT_RETENTION_DAYS=14
ARTIFACT_CLEANUP_BATCH_SIZE=100
# Production allows explicit HTTPS frontend origins only; wildcards are rejected.
CORS_ALLOWED_ORIGINS=
# Public Cloudflare Pages build variables only. Never put a database, Redis, service-role, or JWT signing secret in NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
MAX_REQUEST_BYTES=1048576
# Phase 11 API abuse ceilings. The local process limiter is complemented by an
# edge/shared limiter before production deployment; do not treat it as authentication.
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
DEV_PRINCIPAL_EMAIL=developer@example.invalid
WORKER_LEASE_SECONDS=120
MAX_CONCURRENT_JOBS=2
# Phase 3 browser-engine development defaults. The worker uses a configurable,
# identifiable user agent and blocks private, loopback, link-local, and unsupported targets.
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_PAGE_TIMEOUT_MS=45000
BROWSER_LAUNCH_TIMEOUT_MS=30000
BROWSER_SHUTDOWN_TIMEOUT_MS=10000
BROWSER_MAX_PAGES=1
BROWSER_MAX_REDIRECTS=5
BROWSER_MAX_CONTEXTS=2
BROWSER_MAX_CONCURRENCY=1
BROWSER_MAX_LIFETIME_SECONDS=120
BROWSER_MAX_RESPONSE_BYTES=10485760
BROWSER_MAX_SCREENSHOT_BYTES=5242880
BROWSER_MAX_DOWNLOAD_BYTES=10485760
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE_ID=UTC
BROWSER_USER_AGENT=WebDataExtractionEngine/0.3 (+https://github.com/gulshanverse/web-data-extraction-engine)
# Phase 4 planner defaults. Leave endpoint and key empty unless intentionally
# configuring a real OpenAI Chat Completions-compatible provider locally.
PLANNER_PROVIDER=openai_compatible
PLANNER_MODEL=gpt-5-mini
PLANNER_API_ENDPOINT=
PLANNER_API_KEY=
PLANNER_TIMEOUT_SECONDS=30
PLANNER_MAX_RETRIES=2
PLANNER_MAX_OUTPUT_TOKENS=2048
PLANNER_MAX_TASK_CHARS=8000
PLANNER_MAX_PAGES=100
PLANNER_MAX_RECORDS=10000
PLANNER_MAX_FIELDS=64
PLANNER_MAX_OUTPUTS=7
# Phase 5 discovery defaults. These are server-owned ceilings; canonical plans
# cannot enlarge them. Sitemap support is intentionally opt-in and still uses
# the existing browser policy for navigation.
DISCOVERY_MAX_PAGES=100
DISCOVERY_MAX_DEPTH=2
DISCOVERY_MAX_LINKS_PER_PAGE=200
DISCOVERY_MAX_CONCURRENCY=1
DISCOVERY_MIN_DELAY_SECONDS=0
DISCOVERY_SCOPE_POLICY=SAME_ORIGIN
DISCOVERY_ENABLE_SITEMAPS=false
DISCOVERY_SITEMAP_MAX_BYTES=1048576
DISCOVERY_SITEMAP_MAX_URLS=500
DISCOVERY_SITEMAP_MAX_DEPTH=1
# Phase 6 extraction defaults. These server-owned limits bound the static
# browser document signal and durable candidate record evidence. No AI model is
# used by the deterministic Phase 6 engine.
EXTRACTION_MAX_RECORDS=10000
EXTRACTION_MAX_EVIDENCE_CHARS=500
EXTRACTION_MAX_DOCUMENT_CHARS=200000
EXTRACTION_MAX_DOCUMENT_ITEMS=500
EXTRACTION_MAX_RETRIES=2
# Phase 10R export lifecycle ceilings. Export writers and document renderers
# receive only validated canonical datasets; the worker owns these limits.
EXPORT_MAX_RECORDS=10000
EXPORT_MAX_BYTES=25165824
EXPORT_TIMEOUT_SECONDS=60
EXPORT_MAX_CONCURRENCY=2
EXPORT_MAX_RETRIES=2
# Phase 7 validation is deterministic and has no model or browser settings.
# Validation runs remain internal durable results; this phase does not export files.
