# Copy this file to .env for local development when configuration is introduced.
# Copy to .env for local development. Keep credentials and environment-specific values out of version control.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://wde:wde@localhost:5432/wde
REDIS_URL=redis://localhost:6379/0
ARTIFACT_ROOT=/tmp/web-data-extraction-engine-artifacts
MAX_REQUEST_BYTES=1048576
DEV_PRINCIPAL_EMAIL=developer@example.invalid
WORKER_LEASE_SECONDS=120
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Phase 3 browser-engine development defaults. The worker uses a configurable,
# identifiable user agent and blocks private, loopback, link-local, and unsupported targets.
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_PAGE_TIMEOUT_MS=45000
BROWSER_LAUNCH_TIMEOUT_MS=30000
BROWSER_SHUTDOWN_TIMEOUT_MS=10000
BROWSER_MAX_PAGES=1
BROWSER_MAX_REDIRECTS=5
BROWSER_MAX_CONTEXTS=2
BROWSER_MAX_LIFETIME_SECONDS=120
BROWSER_MAX_RESPONSE_BYTES=10485760
BROWSER_MAX_SCREENSHOT_BYTES=5242880
BROWSER_MAX_DOWNLOAD_BYTES=10485760
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE_ID=UTC
BROWSER_USER_AGENT=WebDataExtractionEngine/0.3 (+https://github.com/gulshanverse/web-data-extraction-engine)
# Phase 4 planner defaults. Leave endpoint and key empty unless intentionally
# configuring a real OpenAI Chat Completions-compatible provider locally.
PLANNER_PROVIDER=openai_compatible
PLANNER_MODEL=gpt-5-mini
PLANNER_API_ENDPOINT=
PLANNER_API_KEY=
PLANNER_TIMEOUT_SECONDS=30
PLANNER_MAX_RETRIES=2
PLANNER_MAX_OUTPUT_TOKENS=2048
PLANNER_MAX_TASK_CHARS=8000
PLANNER_MAX_PAGES=100
PLANNER_MAX_RECORDS=10000
PLANNER_MAX_FIELDS=64
PLANNER_MAX_OUTPUTS=7
